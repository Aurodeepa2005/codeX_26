.pytest_cache/

# --- Data (raw & processed — too large / not for version control) ---
data/raw/
data/processed/
data/evaluation/labelled_results.csv

# --- ML Artifacts (generated, not to be committed) ---
models/
indexes/faiss/
indexes/bm25/

# --- Logs ---
*.log
data/raw/logs/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Temporary ---
tmp/
scratch/
