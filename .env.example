# ============================================================
# StandardMatch AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Collection Settings ---
# Delay between HTTP requests in seconds (respect rate limits)
BIS_REQUEST_DELAY_SECONDS=2.5

# Maximum standards to collect per run
BIS_MAX_RECORDS=50

# HTTP request timeout in seconds
BIS_REQUEST_TIMEOUT=15

# Max retries on failed requests
BIS_MAX_RETRIES=3

# --- Source Settings ---
BIS_SEARCH_BASE_URL=https://standardsbis.bsbedge.com
BIS_SEARCH_ENDPOINT=/BIS_SearchStandard.aspx

# --- Logging ---
LOG_LEVEL=INFO

# --- Future Phases (leave blank for now) ---
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=
# DATABASE_URL=
